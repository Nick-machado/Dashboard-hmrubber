#!/usr/bin/env bash
set -e

echo "📥 Baixando Firebird ODBC driver v3.0..."
DRIVER_URL="https://github.com/FirebirdSQL/firebird-odbc-driver/releases/download/v3-0-0/OdbcFb-LIB-3.0.0.amd64.tar.gz"
wget -O driver.tar.gz "$DRIVER_URL"

echo "🔓 Extraindo o driver (.tar.gz)..."
mkdir -p driver
tar -xzf driver.tar.gz -C driver

echo "📂 Instalando libOdbcFb.so em /app/.apt/usr/lib..."
cp driver/libOdbcFb.so /app/.apt/usr/lib/libOdbcFb.so
chmod 755 /app/.apt/usr/lib/libOdbcFb.so

echo "📝 Registrando o driver no odbcinst.ini..."
cat >> /app/.apt/etc/odbcinst.ini <<EOF
[Firebird]
Description = Firebird ODBC Driver v3.0
Driver      = /app/.apt/usr/lib/libOdbcFb.so
Setup       = /app/.apt/usr/lib/libOdbcFb.so
EOF

echo "✅ Driver Firebird ODBC instalado."